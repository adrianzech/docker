{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "assignees": ["adrianzech"],
  "labels": ["renovate"],
  "configMigration": true,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres", "docker.io/library/postgres"],
      "allowedVersions": "/^18\\.\\d+(?:-|$)/"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "allowedVersions": "/^18-/"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["timescale/timescaledb-ha"],
      "allowedVersions": "/^pg18\\./"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgis/postgis"],
      "allowedVersions": "/^17-/"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["gotenberg/gotenberg"],
      "allowedVersions": "/^8\\.\\d+\\.\\d+$/"
    }
  ],
  "hostRules": [
    {
      "matchHost": "docker.io",
      "concurrentRequestLimit": 2
    },
    {
      "matchHost": "ghcr.io",
      "concurrentRequestLimit": 1,
      "maxRequestsPerSecond": 1
    },
    {
      "matchHost": "lscr.io",
      "concurrentRequestLimit": 1,
      "maxRequestsPerSecond": 1
    }
  ]
}
